{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bahodir Brat Lottery Bot",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "bahodir-lottery/overview",
              "bahodir-lottery/architecture"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "bahodir-lottery/user-features",
              "bahodir-lottery/admin-features",
              "bahodir-lottery/payment-system"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "bahodir-lottery/security"
            ]
          },
          {
            "group": "API reference",
            "pages": [
              "bahodir-lottery/api-reference"
            ]
          }
        ]
      },
      {
        "tab": "Mintlify Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "Mintlify API",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "YouTube Channel",
          "href": "https://youtube.com/@bahodirbrat",
          "icon": "youtube"
        },
        {
          "anchor": "Telegram Bot",
          "href": "https://t.me/BahodirLotteryBot",
          "icon": "paper-plane"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://t.me/BahodirLotterySupport"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Admin Panel",
      "href": "https://lottery.bahodirbrat.com/admin"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
